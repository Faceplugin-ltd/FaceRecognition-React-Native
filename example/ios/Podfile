# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# VisionCamera: document OCR does not need GPS.
$VCEnableLocation = false

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FaceRecognitionSdkExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'FaceRecognitionSdkExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    sign_script_path = File.expand_path('scripts/sign_nested_facerecognitionsdk.sh', __dir__)
    File.chmod(0755, sign_script_path) if File.exist?(sign_script_path)
    # Use SRCROOT so the phase works after moving the tree; avoid baked-in absolute paths.
    sign_script = "\"${SRCROOT}/scripts/sign_nested_facerecognitionsdk.sh\"\n"

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        next unless target.product_type == 'com.apple.product-type.application'
        phase = target.shell_script_build_phases.find { |p| p.name == 'Sign nested facerecognitionsdk engine' }
        if phase.nil?
          phase = target.new_shell_script_build_phase('Sign nested facerecognitionsdk engine')
        end
        phase.shell_script = sign_script
      end
    end
  end
end
